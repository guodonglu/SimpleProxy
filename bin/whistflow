#!/usr/bin/env python3
"""
WhistFlow Command Line Interface (CLI)
Lightweight control utility for WhistFlow native macOS proxy server.
Zero external dependencies. Works directly with WhistFlow local management API.
"""

import sys
import os
import json
import urllib.request
import urllib.error
import argparse

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 9898
BASE_URL = f"http://{DEFAULT_HOST}:{DEFAULT_PORT}/_whistflow/api"

# ANSI Colors for terminal output
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"

def api_call(endpoint: str, data: dict = None, method: str = None) -> dict:
    url = f"{BASE_URL}/{endpoint}"
    req = urllib.request.Request(url)
    if data is not None:
        req.data = json.dumps(data).encode("utf-8")
        req.add_header("Content-Type", "application/json")
        req.method = method or "POST"
    elif method:
        req.method = method

    try:
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            content = resp.read().decode("utf-8")
            return json.loads(content)
    except urllib.error.URLError as e:
        print(f"{RED}Error: Cannot connect to WhistFlow at 127.0.0.1:{DEFAULT_PORT}.{RESET}", file=sys.stderr)
        print(f"{DIM}Make sure WhistFlow.app is running.{RESET}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"{RED}Error:{RESET} {e}", file=sys.stderr)
        sys.exit(1)

def cmd_status(args):
    data = api_call("status")
    print(f"\n{BOLD}{CYAN}=== WhistFlow macOS Proxy Status ==={RESET}")
    status_color = GREEN if data.get("status") == "running" else RED
    print(f"  {BOLD}Status:{RESET}          {status_color}{data.get('status', 'unknown').upper()}{RESET}")
    print(f"  {BOLD}Local Port:{RESET}      {CYAN}{data.get('port', DEFAULT_PORT)}{RESET}")
    print(f"  {BOLD}Active Rules:{RESET}    {data.get('rules_count', 0)}")
    print(f"  {BOLD}Total Requests:{RESET}  {data.get('total_requests', 0)}")
    print(f"  {BOLD}Matched Hits:{RESET}    {GREEN}{data.get('matched_requests', 0)}{RESET}")
    print(f"  {BOLD}Version:{RESET}         v{data.get('version', '1.0.0')}\n")

def cmd_list(args):
    data = api_call("rules")
    rules = data.get("rules", [])
    print(f"\n{BOLD}{CYAN}=== WhistFlow Active Rules ({len(rules)}) ==={RESET}")
    if not rules:
        print(f"  {DIM}(No rules configured. Use 'whistflow add <pattern> <target>' to add one){RESET}\n")
        return

    # Print formatted table
    print(f"  {'#':<4} {'STATE':<8} {'TYPE':<8} {'PATTERN':<28} {'TARGET':<35} {'COMMENT':<16}")
    print("  " + "-" * 105)

    for idx, rule in enumerate(rules, 1):
        is_on = rule.get("enabled", True)
        state_str = f"{GREEN}[ON] {RESET}" if is_on else f"{DIM}[OFF]{RESET}"
        rtype_str = f"{YELLOW}{rule.get('type', 'HOST'):<6}{RESET}"
        pat = rule.get("pattern", "")
        if len(pat) > 26: pat = pat[:23] + "..."
        tgt = rule.get("target", "")
        if len(tgt) > 33: tgt = tgt[:30] + "..."
        comment = rule.get("comment", "")
        if len(comment) > 15: comment = comment[:12] + "..."

        row = f"  {idx:<4} {state_str} {rtype_str} {pat:<28} {tgt:<35} {comment:<16}"
        print(row)
    print()

def cmd_add(args):
    line = " ".join(args.rule)
    data = api_call("rules/add", {"rule": line})
    print(f"{GREEN}✓ Successfully added rule:{RESET} {BOLD}{data.get('raw', line)}{RESET}")

def cmd_toggle(args):
    target = args.target
    data = api_call("rules/toggle", {"pattern": target, "id": target})
    print(f"{GREEN}✓ Rule toggled:{RESET} {target}")

def cmd_rm(args):
    target = args.target
    data = api_call("rules/delete", {"pattern": target, "id": target})
    print(f"{GREEN}✓ Rule deleted:{RESET} {target}")

def cmd_raw(args):
    if args.content:
        content = args.content
    elif not sys.stdin.isatty():
        content = sys.stdin.read()
    else:
        # Fetch current raw config
        data = api_call("rules")
        print(data.get("raw", ""))
        return

    data = api_call("rules/raw", {"content": content})
    print(f"{GREEN}✓ Rules updated from raw content ({data.get('count', 0)} rules loaded).{RESET}")

def cmd_clear(args):
    data = api_call("rules/clear")
    print(f"{GREEN}✓ All rules cleared.{RESET}")

def cmd_theme(args):
    mode = args.mode.lower()
    data = api_call("appearance", {"mode": mode})
    print(f"{GREEN}✓ Appearance mode switched to:{RESET} {BOLD}{mode}{RESET}")

def cmd_mode(args):
    mode = args.mode.lower()
    data = api_call("mode", {"mode": mode})
    print(f"{GREEN}✓ Window view mode switched to:{RESET} {BOLD}{mode}{RESET}")

def main():
    parser = argparse.ArgumentParser(
        prog="whistflow",
        description="WhistFlow CLI - Native macOS lightweight proxy controller",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  whistflow status                         # View proxy server health and stats
  whistflow list                           # List all configured rules
  whistflow add api.dev.com 127.0.0.1:3000 # Add Host mapping
  whistflow add mock.com/user "resBody://({'id':1})" # Add Mock API
  whistflow toggle api.dev.com             # Toggle rule on/off
  whistflow rm api.dev.com                 # Delete rule
  whistflow raw                            # Display raw Whistle config
  cat rules.txt | whistflow raw            # Import raw Whistle rules
  whistflow theme light                    # Switch app theme to Light
  whistflow theme dark                     # Switch app theme to Dark
  whistflow mode visual                    # Switch to Visual Mode
  whistflow mode config                    # Switch to Config Mode
"""
    )
    subparsers = parser.add_subparsers(dest="command", help="Subcommand to execute")

    # status
    p_status = subparsers.add_parser("status", help="Show proxy server running status and statistics")
    p_status.set_defaults(func=cmd_status)

    # list / ls
    p_list = subparsers.add_parser("list", aliases=["ls"], help="List all proxy rules")
    p_list.set_defaults(func=cmd_list)

    # add
    p_add = subparsers.add_parser("add", help="Add a new proxy rule")
    p_add.add_argument("rule", nargs="+", help="Rule string (e.g. pattern target)")
    p_add.set_defaults(func=cmd_add)

    # toggle
    p_toggle = subparsers.add_parser("toggle", help="Toggle rule state (pattern or ID)")
    p_toggle.add_argument("target", help="Rule pattern or ID")
    p_toggle.set_defaults(func=cmd_toggle)

    # rm / delete
    p_rm = subparsers.add_parser("rm", aliases=["delete"], help="Delete a rule by pattern or ID")
    p_rm.add_argument("target", help="Rule pattern or ID")
    p_rm.set_defaults(func=cmd_rm)

    # raw
    p_raw = subparsers.add_parser("raw", help="View or update raw Whistle configuration")
    p_raw.add_argument("content", nargs="?", default=None, help="Raw Whistle configuration string (optional, reads stdin if piped)")
    p_raw.set_defaults(func=cmd_raw)

    # clear
    p_clear = subparsers.add_parser("clear", help="Clear all proxy rules")
    p_clear.set_defaults(func=cmd_clear)

    # theme
    p_theme = subparsers.add_parser("theme", help="Set appearance theme (light, dark, system)")
    p_theme.add_argument("mode", choices=["light", "dark", "system"], help="Appearance mode")
    p_theme.set_defaults(func=cmd_theme)

    # mode
    p_mode = subparsers.add_parser("mode", help="Set window view mode (visual, config)")
    p_mode.add_argument("mode", choices=["visual", "config"], help="Window view mode")
    p_mode.set_defaults(func=cmd_mode)

    args = parser.parse_args()
    if hasattr(args, "func"):
        args.func(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
